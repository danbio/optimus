# Copiar para .env e preencher os valores.
# Gerar SECRET_KEY com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# ── Desenvolvimento (padrão) ──────────────────────────────────────────────────
SECRET_KEY=substitua-por-chave-gerada-acima
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Produção ──────────────────────────────────────────────────────────────────
# Definir DJANGO_ENV=production liga HTTPS obrigatório, cookies seguros e HSTS.
# Não usar em dev: o servidor local é HTTP e o login para de funcionar.
#
# Em produção, essas variáveis vêm do ambiente real da hospedagem — NÃO de um
# arquivo .env no servidor. Um .env de desenvolvimento parado lá seria
# ignorado de propósito (settings.py só lê .env quando DJANGO_ENV não é
# "production"), e DEBUG é travado em False sempre que IS_PRODUCTION, mesmo
# que a variável DEBUG exista e diga outra coisa.
# DJANGO_ENV=production
# ALLOWED_HOSTS=erp.optimusto.com.br
# CSRF_TRUSTED_ORIGINS=https://erp.optimusto.com.br

# PostgreSQL — sem esta variável o projeto usa SQLite local.
# DATABASE_URL=postgres://usuario:senha@host:5432/optimus
# DATABASE_SSLMODE=require
